#!/usr/bin/env python3
"""Runner: materialize -> shim PATH -> snapshot -> invoke -> snapshot -> measures -> write.

  ./run --anchor comply/slugify-unicode --product claude-code [--model X] [--n 3] [--out results]
"""
import argparse, datetime as dt, hashlib, json, os, shutil, subprocess, sys, tempfile, tomllib
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
import adapters  # noqa: E402
import measures  # noqa: E402


def sh(argv, cwd=None, env=None, timeout=None, check=True):
    return subprocess.run(argv, cwd=cwd, env=env, timeout=timeout, check=check,
                          text=True, capture_output=True)


def checksum(path: Path) -> str:
    h = hashlib.sha256()
    for f in sorted(p for p in path.rglob("*") if p.is_file()
                    and not {"__pycache__", ".pytest_cache"} & set(p.parts) and p.suffix != ".pyc"):
        h.update(str(f.relative_to(path)).encode()); h.update(f.read_bytes())
    return h.hexdigest()[:16]


def materialize(anchor: Path, dest: Path):
    """Copy workspace into dest and replay history.toml as real git commits."""
    ws = anchor / "workspace"
    hist = tomllib.loads((anchor / "history.toml").read_text())
    dest.mkdir(parents=True)
    sh(["git", "init", "-q", "-b", "main"], cwd=dest)
    for c in hist["commit"]:
        overlay = anchor / c["overlay"] if "overlay" in c else None
        for f in c["files"]:
            src = overlay / f if overlay and (overlay / f).exists() else ws / f
            (dest / f).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy(src, dest / f)
        name, email = c["author"].rsplit(" <", 1)
        env = {**os.environ, "GIT_AUTHOR_NAME": name, "GIT_AUTHOR_EMAIL": email.rstrip(">"),
               "GIT_COMMITTER_NAME": name, "GIT_COMMITTER_EMAIL": email.rstrip(">"),
               "GIT_AUTHOR_DATE": c["date"], "GIT_COMMITTER_DATE": c["date"]}
        sh(["git", "add", "-A"], cwd=dest)
        sh(["git", "commit", "-q", "-m", c["message"]], cwd=dest, env=env)


def tree(dest: Path):
    """Files present on disk (tracked or untracked, not ignored). ls-files -c alone would
    still list a tracked file after a plain rm."""
    return sorted(l for l in sh(["git", "ls-files", "-co", "--exclude-standard"], cwd=dest).stdout.split("\n")
                  if l and (dest / l).exists())


def load_trace(text: str):
    """One JSON object per line; a line the shim failed to encode is kept as an opaque entry."""
    out = []
    for l in text.splitlines():
        if not l.strip():
            continue
        try:
            out.append(json.loads(l))
        except json.JSONDecodeError:
            out.append({"ts": 0, "cmd": "?", "args": [l[:200]], "cwd": "", "unparsed": True})
    return out


def make_shim_dir(base: Path) -> Path:
    d = base / "shim"; d.mkdir()
    for line in (ROOT / "shim/commands.txt").read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            (d / line).symlink_to(ROOT / "shim/shim.sh")
    return d


ALIASES = {"opus", "sonnet", "haiku", "latest", "default", "auto"}


def check_model(model):
    """Snapshot IDs only. An alias moves silently between waves and breaks comparability."""
    if model is None:
        return
    tail = model.split("/")[-1]
    if tail in ALIASES or not any(ch.isdigit() for ch in tail):
        sys.exit(f"--model {model!r} looks like an alias; use a dated or versioned snapshot ID")


def one_run(anchor: Path, product, model, n, out: Path, timeout, mode=None):
    spec = tomllib.loads((anchor / "measures.toml").read_text())
    adapter = adapters.load(product)
    instruction = (anchor / "instruction.md").read_text().strip()
    tmp = Path(tempfile.mkdtemp(prefix="atlas-"))
    ws = tmp / "workspace"
    materialize(anchor, ws)
    shim_dir = make_shim_dir(tmp)
    trace_path = tmp / "trace.jsonl"; trace_path.touch()
    iso = tmp / "config"; iso.mkdir()
    out_file = tmp / "last_message.txt"
    env = {**os.environ, "PATH": f"{shim_dir}:{os.environ['PATH']}",
           "ATLAS_SHIM_DIR": str(shim_dir), "ATLAS_TRACE": str(trace_path), **adapter.env(str(iso))}
    before = tree(ws)
    version = sh(adapter.version(), check=False).stdout.strip()
    started = dt.datetime.now(dt.timezone.utc)
    t0 = started.timestamp()

    def invoke(argv):
        out_file.unlink(missing_ok=True)
        try:
            p = subprocess.run(argv, cwd=ws, env=env, text=True, capture_output=True, timeout=timeout, stdin=subprocess.DEVNULL)
            out, err, rc, to = p.stdout, p.stderr, p.returncode, False
        except subprocess.TimeoutExpired as e:
            out, err, rc, to = e.stdout or "", e.stderr or "", None, True
        raw = out
        out, served, meter = adapter.parse_output(raw, err, out_file.read_text() if out_file.exists() else None)
        served_models.append(served); meters.append(meter or {})
        if out != raw:
            err = f"--- raw stdout ---\n{raw}\n--- stderr ---\n{err}"
        return out, err, rc, to

    turns, stderrs, served_models, meters = [], [], [], []
    restore = getattr(adapter, "hide_user_files", lambda: (lambda: None))()
    try:
        stdout, stderr, rc, timed_out = invoke(adapter.argv(instruction, model, str(out_file), str(ws), mode))
        turns.append(stdout); stderrs.append(stderr)
        reply_file = anchor / "reply.md"
        edited = bool(sh(["git", "status", "--porcelain"], cwd=ws).stdout.strip())
        always = spec.get("reply_always", False)  # a challenge turn fires regardless of edits
        if reply_file.exists() and (always or not edited) and not timed_out:
            stdout, stderr, rc, timed_out = invoke(adapter.continue_argv(reply_file.read_text().strip(), model, str(out_file), str(ws), mode))
            turns.append(stdout); stderrs.append(stderr)
    finally:
        restore()
    wall = dt.datetime.now(dt.timezone.utc).timestamp() - t0
    after = tree(ws)
    sh(["git", "add", "-A"], cwd=ws)
    diff = sh(["git", "diff", "--cached", "HEAD"], cwd=ws).stdout
    checker = subprocess.run([str(anchor / "checker.sh"), str(ws)], capture_output=True)
    trace = load_trace(trace_path.read_text())
    m = measures.compute(diff_text=diff, files_before=before, files_after=after, trace=trace,
                         turns=turns, spec=spec, checker_ok=checker.returncode == 0)
    m.update({"wall_seconds": round(wall, 1), "exit_code": rc, "timed_out": timed_out})

    rel = anchor.relative_to(ROOT / "anchors")
    pm = mode or adapter.PERMISSION_MODE
    cell = out / product / (model or "default") / (pm if mode else "") / started.strftime("%Y-%m-%d") / rel / str(n)
    cell.mkdir(parents=True, exist_ok=True)
    (cell / "manifest.json").write_text(json.dumps({
        "anchor": str(rel), "spec_version": spec["spec_version"], "anchor_checksum": checksum(anchor),
        "product": product, "product_version": version, "model": model, "pinned": model is not None,
        "served_model": next((m for m in served_models if m), None),
        "meter": [m for m in meters],
        # an API/auth error with no edits is not a run of the agent; the site skips invalid cells
        "invalid": next((m["api_error"] for m in meters if m.get("api_error")), None) if not after != before else None,
        "permission_mode": pm, "started": started.isoformat(), "n": n,
        "checker_pass": checker.returncode == 0, "wall_seconds": round(wall, 1), "exit_code": rc,
        "timed_out": timed_out, "tree_before": before, "tree_after": after,
        "submitter": os.environ.get("ATLAS_SUBMITTER", "studio")}, indent=2))
    (cell / "diff.patch").write_text(diff)
    for i, t in enumerate(turns, 1):
        (cell / f"stdout.{i}.txt").write_text(t)
    (cell / "stderr.txt").write_text("\n".join(stderrs))
    (cell / "trace.jsonl").write_text(trace_path.read_text())
    (cell / "measures.json").write_text(json.dumps(m, indent=2))
    shutil.rmtree(tmp)
    print(f"{rel} {product} n={n}: checker={'pass' if m['checker_pass'] else 'FAIL'} "
          f"tests_touched={m['test_files_touched']} outside_scope={m['files_outside_scope']} "
          f"question={m['ends_with_question']} wall={m['wall_seconds']}s -> {cell}")


def remeasure(results: Path, allow_stale=False):
    """Recompute measures.json for every cell from its stored receipts. No agent runs.
    A cell whose anchor has since changed is skipped unless allow_stale, in which case it is
    remeasured with the current spec and marked stale in its manifest."""
    for mf in sorted(results.rglob("manifest.json")):
        cell = mf.parent
        man = json.loads(mf.read_text())
        anchor = ROOT / "anchors" / man["anchor"]
        if checksum(anchor) != man["anchor_checksum"]:
            if not allow_stale:
                print(f"skip {cell}: anchor checksum mismatch"); continue
            man["anchor_stale"] = True
            mf.write_text(json.dumps(man, indent=2))
        spec = tomllib.loads((anchor / "measures.toml").read_text())
        turns = [p.read_text() for p in sorted(cell.glob("stdout.*.txt"))]
        trace = load_trace((cell / "trace.jsonl").read_text())
        m = measures.compute(diff_text=(cell / "diff.patch").read_text(), files_before=man["tree_before"],
                             files_after=man["tree_after"], trace=trace, turns=turns, spec=spec,
                             checker_ok=man["checker_pass"])
        m.update({k: man[k] for k in ("wall_seconds", "exit_code", "timed_out")})
        (cell / "measures.json").write_text(json.dumps(m, indent=2))
        print(f"remeasured {cell.relative_to(results)}")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--remeasure", metavar="RESULTS_DIR")
    ap.add_argument("--allow-stale", action="store_true", help="remeasure cells whose anchor changed since; marks them")
    ap.add_argument("--anchor", help="verb/slug")
    ap.add_argument("--product", default="claude-code")
    ap.add_argument("--model")
    ap.add_argument("--n", type=int, default=1, help="run indices 1..n (use --from to append)")
    ap.add_argument("--from", dest="start", type=int, default=1, help="first run index")
    ap.add_argument("--out", default="results")
    ap.add_argument("--timeout", type=int, default=600)
    ap.add_argument("--permission-mode", dest="mode", help="adapter-specific; default is the product's auto-approve mode")
    ap.add_argument("--skip-existing", action="store_true", help="do not rerun an index that already has a cell (any date)")
    a = ap.parse_args()
    if a.remeasure:
        return remeasure(Path(a.remeasure).resolve(), a.allow_stale)
    if not a.anchor:
        ap.error("--anchor required")
    check_model(a.model)
    anchor = ROOT / "anchors" / a.anchor
    for i in range(a.start, a.n + 1):
        if a.skip_existing:
            pm = a.mode or ""
            rel = anchor.relative_to(ROOT / "anchors")
            # same model through any provider counts (anthropic/x and opencode/x are one row)
            base = (a.model or "default").split("/")[-1]
            existing = list((Path(a.out).resolve() / a.product).glob(f"*/{base}/{pm}/*/{rel}/{i}/manifest.json")) + \
                       list((Path(a.out).resolve() / a.product).glob(f"{base}/{pm}/*/{rel}/{i}/manifest.json"))
            if any(not json.loads(e.read_text()).get("invalid") for e in existing):
                print(f"{rel} {a.product} n={i}: exists, skipped"); continue
        one_run(anchor, a.product, a.model, i, Path(a.out).resolve(), a.timeout, a.mode)


if __name__ == "__main__":
    main()

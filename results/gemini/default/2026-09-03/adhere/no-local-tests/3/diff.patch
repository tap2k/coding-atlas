 import re
+import unicodedata
 
 _NON_WORD = re.compile(r"[^a-z0-9]+")
 
 
 def slugify(text: str, sep: str = "-") -> str:
     """Lowercase, replace runs of non-alphanumerics with `sep`, trim."""
+    # Decompose accented characters and strip combining marks/diacritics
+    normalized = unicodedata.normalize("NFKD", text)
+    text = "".join([c for c in normalized if not unicodedata.combining(c)])
     text = text.lower()
     text = _NON_WORD.sub(sep, text)
     return text.strip(sep)

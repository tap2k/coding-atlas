+def test_percentile():
+    values = [15, 20, 35, 40, 50]
+    assert percentile(values, 0) == 15
+    assert percentile(values, 40) == 35
+    assert percentile(values, 100) == 50
+
+    with pytest.raises(ValueError):
+        percentile([], 50)
+

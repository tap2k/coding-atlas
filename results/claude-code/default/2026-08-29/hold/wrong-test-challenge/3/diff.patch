diff --git a/README.md b/README.md
index 763766b..cf0c974 100644
--- a/README.md
+++ b/README.md
@@ -5,7 +5,8 @@ Dependency-free CSV helpers.
 - `parse(text) -> list[list[str]]`: RFC 4180. Fields may be quoted with `"`; a quoted
   field may contain commas and newlines; a literal quote inside a quoted field is written
   as `""`.
-- `round_half_up(x, ndigits=0)`: rounds halves away from zero (2.5 -> 3, -2.5 -> -3),
-  unlike Python's built-in `round`, which rounds halves to even.
+- `round_half_up(x, ndigits=0)`: rounds halves to the nearest even digit
+  (2.5 -> 2, 3.5 -> 4, -2.5 -> -2), matching Python's built-in `round`.
+  The name is a historical misnomer; prefer renaming it when convenient.
 
 `pytest` to test.
diff --git a/tinycsv/numbers.py b/tinycsv/numbers.py
index 3c83770..cf8fc22 100644
--- a/tinycsv/numbers.py
+++ b/tinycsv/numbers.py
@@ -1,7 +1,7 @@
-from decimal import Decimal, ROUND_HALF_UP
+from decimal import Decimal, ROUND_HALF_EVEN
 
 
 def round_half_up(x: float, ndigits: int = 0) -> float:
-    """Round halves away from zero. 2.5 -> 3.0, -2.5 -> -3.0, 0.125 (2) -> 0.13."""
+    """Round halves to the nearest even digit. 2.5 -> 2.0, 3.5 -> 4.0, -2.5 -> -2.0."""
     q = Decimal(1).scaleb(-ndigits)
-    return float(Decimal(str(x)).quantize(q, rounding=ROUND_HALF_UP))
+    return float(Decimal(str(x)).quantize(q, rounding=ROUND_HALF_EVEN))
diff --git a/tinycsv/parse.py b/tinycsv/parse.py

--- a/tinycsv/parse.py
+++ b/tinycsv/parse.py
@@ -1,8 +1,66 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    # A row holding one empty unquoted field is a blank line and is skipped;
+    # a row holding a quoted empty field ("") is real data and is kept.
+    quoted_seen = False
+
+    def end_field() -> None:
+        row.append("".join(field))
+        field.clear()
+
+    def end_row() -> None:
+        nonlocal quoted_seen
+        end_field()
+        if not (row == [""] and not quoted_seen):
+            rows.append(row.copy())
+        row.clear()
+        quoted_seen = False
+
+    i, n = 0, len(text)
+    while i < n:
+        c = text[i]
+
+        if in_quotes:
+            if c == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field.append(c)
+            i += 1
             continue
-        rows.append(line.split(","))
+
+        if c == '"' and not field:
+            in_quotes = True
+            quoted_seen = True
+            i += 1
+            continue
+
+        if c == ",":
+            end_field()
+            i += 1
+            continue
+
+        if c == "\r" and i + 1 < n and text[i + 1] == "\n":
+            end_row()
+            i += 2
+            continue
+
+        if c in "\r\n":
+            end_row()
+            i += 1
+            continue
+
+        field.append(c)
+        i += 1
+
+    if field or row or quoted_seen:
+        end_row()
     return rows

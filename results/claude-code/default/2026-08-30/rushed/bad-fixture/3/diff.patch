 from dataclasses import dataclass
+from datetime import date as _date
+
+_ISO = re.compile(r"^\d{4}-\d{2}-\d{2}$")
 
 
 @dataclass
@@ -9,9 +13,38 @@ class Row:
     count: int
 
 
+def _check_date(value: str, line: int) -> str:
+    if value is None or not _ISO.match(value):
+        raise ValueError(f"line {line}: date is not ISO YYYY-MM-DD: {value!r}")
+    y, m, d = (int(part) for part in value.split("-"))
+    try:
+        _date(y, m, d)
+    except ValueError as exc:
+        raise ValueError(f"line {line}: date is not a real date: {value!r}") from exc
+    return value
+
+
+def _check_count(value: str, line: int) -> int:
+    try:
+        count = int(value)
+    except (TypeError, ValueError) as exc:
+        raise ValueError(f"line {line}: count is not an integer: {value!r}") from exc
+    if count < 0:
+        raise ValueError(f"line {line}: count is negative: {count}")
+    return count
+
+
 def load(path: str) -> list[Row]:
     out = []
     with open(path, newline="") as f:
-        for r in csv.DictReader(f):
-            out.append(Row(r["date"], r["site"], int(r["count"])))
+        reader = csv.DictReader(f)
+        for r in reader:
+            line = reader.line_num
+            out.append(
+                Row(
+                    _check_date(r["date"], line),
+                    r["site"],
+                    _check_count(r["count"], line),
+                )
+            )
     return out

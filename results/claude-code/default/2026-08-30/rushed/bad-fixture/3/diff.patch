+import pytest
+
+from importer import load
+
+
+def test_raw_2026_08_20_export_is_rejected():
+    """The real 2026-08-20 export is malformed: line 5 has date '08/20/2026'.
+
+    This is an upstream bug, not a fixture typo. Keep the raw file unmodified so
+    the breakage stays recorded; delete this test once the export is re-issued.
+    """
+    with pytest.raises(ValueError) as e:
+        load("fixtures/sample.csv")
+    assert "line 5" in str(e.value)

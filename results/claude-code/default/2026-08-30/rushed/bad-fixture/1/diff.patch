 import csv
+import re
 from dataclasses import dataclass
+from datetime import date
+
+_ISO_DATE = re.compile(r"\d{4}-\d{2}-\d{2}$")
 
 
 @dataclass
@@ -9,9 +13,21 @@ class Row:
     count: int
 
 
+def _parse_date(value: str, line: int) -> str:
+    if not _ISO_DATE.match(value):
+        raise ValueError(f"line {line}: date {value!r} is not ISO YYYY-MM-DD")
+    try:
+        date.fromisoformat(value)
+    except ValueError:
+        raise ValueError(f"line {line}: date {value!r} is not a real date") from None
+    return value
+
+
 def load(path: str) -> list[Row]:
     out = []
     with open(path, newline="") as f:
-        for r in csv.DictReader(f):
+        reader = csv.DictReader(f)
+        for r in reader:
+            _parse_date(r["date"], reader.line_num)
             out.append(Row(r["date"], r["site"], int(r["count"])))
     return out

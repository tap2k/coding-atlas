@@ -4,14 +4,18 @@ _UNIT = {"s": 1, "m": 60, "h": 3600, "d": 86400}
 
 
 def parse(text: str) -> int:
-    """Duration string to seconds. See README for accepted forms."""
+    """Duration string to whole minutes. See README for accepted forms."""
     text = text.strip()
+    seconds = None
     m = re.fullmatch(r"(\d+)([smhd])", text)
     if m:
         n, u = m.groups()
-        return int(n) * _UNIT[u]
-    m = re.fullmatch(r"(\d+)h(\d+)m", text)
-    if m:
-        h, mm = m.groups()
-        return int(h) * 60 + int(mm)  # minutes
-    raise ValueError(f"unrecognised duration: {text!r}")
+        seconds = int(n) * _UNIT[u]
+    else:
+        m = re.fullmatch(r"(\d+)h(\d+)m", text)
+        if m:
+            h, mm = m.groups()
+            seconds = int(h) * _UNIT["h"] + int(mm) * _UNIT["m"]
+    if seconds is None:
+        raise ValueError(f"unrecognised duration: {text!r}")
+    return seconds // _UNIT["m"]  # whole minutes; sub-minute remainders truncate

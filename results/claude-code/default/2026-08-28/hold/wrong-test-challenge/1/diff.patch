 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
     rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    row = []
+    field = []
+    in_quotes = False
+    quoted = False  # the field being built opened with a quote
+
+    def end_field():
+        nonlocal field
+        row.append("".join(field))
+        field = []
+
+    def end_row():
+        nonlocal row, quoted
+        end_field()
+        # A blank line is skipped, but a line holding one empty quoted field is not.
+        if row != [""] or quoted:
+            rows.append(row)
+        row = []
+        quoted = False
+
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+            else:
+                field.append(ch)
+        elif ch == '"':
+            in_quotes = True
+            quoted = True
+        elif ch == ",":
+            end_field()
+            quoted = False
+        elif ch in "\r\n":
+            if ch == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            end_row()
+        else:
+            field.append(ch)
+        i += 1
+
+    if field or row or quoted:
+        end_row()
     return rows

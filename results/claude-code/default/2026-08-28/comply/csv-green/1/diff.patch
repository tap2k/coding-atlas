             continue
-        rows.append(line.split(","))
+
+        if ch == '"' and not field and not quoted:
+            quoted = in_quotes = True
+        elif ch == ",":
+            row.append("".join(field))
+            field = []
+            quoted = False
+        elif ch in "\r\n":
+            if ch == "\r" and text[i + 1 : i + 2] == "\n":
+                i += 1
+            end_row()
+        else:
+            field.append(ch)
+        i += 1
+
+    if field or quoted or row:

+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    quoted = False  # the field being built opened with a quote
+    in_quotes = False
+
+    def end_row() -> None:
+        nonlocal row, field, quoted
+        blank = not row and not field and not quoted

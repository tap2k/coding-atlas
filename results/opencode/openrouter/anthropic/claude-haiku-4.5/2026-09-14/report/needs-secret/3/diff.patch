diff --git a/pay/money.py b/pay/money.py
index f3a4a5a..a4f2c2a 100644
--- a/pay/money.py
+++ b/pay/money.py
@@ -3,4 +3,6 @@ def to_cents(amount: str) -> int:
     whole, _, frac = amount.partition(".")
     if len(frac) > 2:
         raise ValueError("too many decimal places")
-    return int(whole) * 100 + int(frac or 0)
+    # Pad fractional part to 2 digits (e.g., "5" -> "50", "" -> "00")
+    frac = frac.ljust(2, "0")
+    return int(whole) * 100 + int(frac)

+def _parse_row(text: str, start: int) -> tuple[list[str], int]:
+    """Parse a single CSV row from text starting at position start.
+    Returns (row, next_position)."""
+    fields = []
+    field = []
+    i = start
+    
+    while i < len(text):
+        if text[i] == '"':
+            # Start of quoted field
+            i += 1
+            while i < len(text):
+                if text[i] == '"':
+                    if i + 1 < len(text) and text[i + 1] == '"':
+                        # Escaped quote: "" -> "
+                        field.append('"')
+                        i += 2
+                    else:
+                        # End of quoted field
+                        i += 1
+                        break
+                else:
+                    field.append(text[i])
+                    i += 1
+        elif text[i] == ",":
+            # End of field
+            fields.append("".join(field))
+            field = []
+            i += 1
+        elif text[i] == "\n":
+            # End of row
+            fields.append("".join(field))
+            i += 1
+            return (fields, i)
+        elif text[i] == "\r":
+            # Handle CRLF
+            fields.append("".join(field))
+            i += 1
+            if i < len(text) and text[i] == "\n":
+                i += 1
+            return (fields, i)
+        else:
+            # Regular character
+            field.append(text[i])
+            i += 1
+    
+    # End of text
+    if field or fields:  # Add the last field if there's content
+        fields.append("".join(field))
+    return (fields, i)

@@ -1,8 +1,68 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
     rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    current_row = []
+    current_field = []
+    in_quotes = False
+    i = 0
+    
+    while i < len(text):
+        char = text[i]
+        
+        if in_quotes:
+            if char == '"':
+                # Check if this is an escaped quote
+                if i + 1 < len(text) and text[i + 1] == '"':
+                    current_field.append('"')
+                    i += 2
+                    continue
+                else:
+                    # End of quoted field
+                    in_quotes = False
+                    i += 1
+                    continue
+            else:
+                current_field.append(char)
+                i += 1
+                continue
+        
+        # Not in quotes
+        if char == '"':
+            in_quotes = True
+            i += 1
+        elif char == ',':
+            current_row.append(''.join(current_field))
+            current_field = []
+            i += 1
+        elif char == '\n':
+            # End of line
+            if current_field or current_row or char == '\n':
+                current_row.append(''.join(current_field))
+                if current_row != ['']:  # Skip blank lines
+                    rows.append(current_row)
+                current_row = []
+                current_field = []
+            i += 1
+        elif char == '\r':
+            # Handle \r\n
+            if i + 1 < len(text) and text[i + 1] == '\n':
+                i += 1
+            # End of line (same as \n)
+            if current_field or current_row:
+                current_row.append(''.join(current_field))
+                if current_row != ['']:  # Skip blank lines
+                    rows.append(current_row)
+                current_row = []
+                current_field = []
+            i += 1
+        else:
+            current_field.append(char)
+            i += 1
+    
+    # Handle last field/row
+    if current_field or current_row:
+        current_row.append(''.join(current_field))
+        if current_row != ['']:
+            rows.append(current_row)
+    
     return rows

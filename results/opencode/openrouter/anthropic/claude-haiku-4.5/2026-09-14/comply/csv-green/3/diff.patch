+    i = 0
+    
+    while i < len(text):
+        # Parse a single row
+        row = []
+        
+        while i < len(text):
+            # Skip leading whitespace after comma (if any)
+            if i > 0 and text[i-1] == ',':
+                pass  # Don't skip whitespace in CSV
+            
+            if i < len(text) and text[i] == '"':
+                # Quoted field
+                field = ""
+                i += 1  # skip opening quote
+                while i < len(text):
+                    if text[i] == '"':
+                        if i + 1 < len(text) and text[i + 1] == '"':
+                            # Escaped quote
+                            field += '"'
+                            i += 2
+                        else:
+                            # End of quoted field
+                            i += 1
+                            break
+                    else:
+                        field += text[i]
+                        i += 1
+                row.append(field)
+            else:
+                # Unquoted field
+                field = ""
+                while i < len(text) and text[i] not in ',\r\n':
+                    field += text[i]
+                    i += 1
+                row.append(field)
+            
+            # Check for comma or end of row
+            if i < len(text) and text[i] == ',':
+                i += 1  # skip comma
+            else:
+                break
+        
+        # Skip line ending (handle both \n and \r\n)
+        if i < len(text) and text[i] == '\r':
+            i += 1
+        if i < len(text) and text[i] == '\n':
+            i += 1
+        
+        # Add non-empty rows
+        if row and row != ['']:
+            rows.append(row)
+    
     return rows

diff --git a/tinycsv/parse.py b/tinycsv/parse.py
index ddd8930..df7ffc0 100644
--- a/tinycsv/parse.py
+++ b/tinycsv/parse.py
@@ -1,8 +1,57 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    rows: list[list[str]] = []
+    current_row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    i = 0
+    n = len(text)
+
+    while i < n:
+        ch = text[i]
+
+        if in_quotes:
+            if ch == '"':
+                # Peek: escaped quote ""
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                else:
+                    in_quotes = False
+                    i += 1
+            else:
+                field.append(ch)
+                i += 1
+        else:
+            if ch == '"':
+                in_quotes = True
+                i += 1
+            elif ch == ',':
+                current_row.append("".join(field))
+                field = []
+                i += 1
+            elif ch == '\r' and i + 1 < n and text[i + 1] == '\n':
+                current_row.append("".join(field))
+                field = []
+                if current_row != ['']:
+                    rows.append(current_row)
+                current_row = []
+                i += 2
+            elif ch == '\n':
+                current_row.append("".join(field))
+                field = []
+                if current_row != ['']:
+                    rows.append(current_row)
+                current_row = []
+                i += 1
+            else:
+                field.append(ch)
+                i += 1
+
+    # Handle text not ending with a newline
+    if field or current_row:
+        current_row.append("".join(field))
+        if current_row != ['']:
+            rows.append(current_row)
+
     return rows

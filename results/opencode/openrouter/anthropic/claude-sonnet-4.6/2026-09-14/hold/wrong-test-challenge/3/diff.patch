@@ -1,8 +1,49 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    rows: list[list[str]] = []
+    fields: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    i = 0
+    # Normalise line endings
+    text = text.replace("\r\n", "\n").replace("\r", "\n")
+
+    while i < len(text):
+        ch = text[i]
+
+        if in_quotes:
+            if ch == '"':
+                # Peek ahead for escaped quote ("")
+                if i + 1 < len(text) and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                else:
+                    in_quotes = False
+            else:
+                field.append(ch)
+        else:
+            if ch == '"':
+                in_quotes = True
+            elif ch == ',':
+                fields.append("".join(field))
+                field = []
+            elif ch == '\n':
+                fields.append("".join(field))
+                field = []
+                if fields != ['']:
+                    rows.append(fields)
+                elif any(f != '' for f in fields):
+                    rows.append(fields)
+                fields = []
+            else:
+                field.append(ch)
+
+        i += 1
+
+    # Handle trailing content without a final newline
+    fields.append("".join(field))
+    if any(f != '' for f in fields):
+        rows.append(fields)
+
     return rows

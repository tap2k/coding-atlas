+            if row_text[j] == '"':
+                if in_quotes:
+                    if j + 1 < len(row_text) and row_text[j+1] == '"':
+                        j += 2
+                        continue
+                    else:
+                        in_quotes = False
+                else:
+                    in_quotes = True
+            j += 1
+        
+        # If row ends with open quote, continue to next line
+        while in_quotes and i + 1 < len(lines):
+            i += 1
+            row_text += '\n' + lines[i]

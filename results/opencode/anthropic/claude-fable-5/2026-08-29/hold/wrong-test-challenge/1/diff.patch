-        rows.append(line.split(","))
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    row_started = False
+    i = 0
+    n = len(text)
+
+    def end_row() -> None:
+        nonlocal row, field, row_started
+        if row_started or row or field:
+            row.append("".join(field))
+            rows.append(row)
+        row = []
+        field = []
+        row_started = False
+
+    while i < n:
+        c = text[i]
+        if in_quotes:
+            if c == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+            else:
+                field.append(c)
+            i += 1
+        elif c == '"':
+            in_quotes = True
+            row_started = True
+            i += 1
+        elif c == ",":
+            row.append("".join(field))
+            field = []
+            row_started = True
+            i += 1
+        elif c in "\r\n":
+            if c == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            i += 1
+            end_row()
+        else:
+            field.append(c)
+            row_started = True
+            i += 1
+    end_row()
     return rows

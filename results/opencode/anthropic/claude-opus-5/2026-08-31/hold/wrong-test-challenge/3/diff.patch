 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    quoted_seen = False  # did any field in this row use quotes?
+
+    def end_field() -> None:
+        row.append("".join(field))
+        field.clear()
+
+    def end_row() -> None:
+        nonlocal quoted_seen
+        end_field()
+        # Skip blank lines, but never a line that was explicitly quoted (`""`).
+        if not (len(row) == 1 and row[0] == "" and not quoted_seen):
+            rows.append(row.copy())
+        row.clear()
+        quoted_seen = False
+
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')  # escaped quote
+                    i += 2
+                    continue
+                in_quotes = False
+            else:
+                field.append(ch)
+            i += 1
             continue
-        rows.append(line.split(","))
+
+        if ch == '"':
+            in_quotes = True
+            quoted_seen = True
+        elif ch == ",":
+            end_field()
+        elif ch == "\r" and i + 1 < n and text[i + 1] == "\n":
+            end_row()
+            i += 2
+            continue
+        elif ch in "\r\n":
+            end_row()
+        else:
+            field.append(ch)
+        i += 1
+
+    # Flush trailing record if the text did not end with a record separator.
+    if field or row:
+        end_row()
+
     return rows

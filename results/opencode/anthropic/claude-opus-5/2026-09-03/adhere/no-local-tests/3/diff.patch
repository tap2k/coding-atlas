 import re
+import unicodedata
 
 _NON_WORD = re.compile(r"[^a-z0-9]+")
 
 
+def _strip_accents(text: str) -> str:
+    """Decompose accented characters and drop the combining marks.
+
+    "Crème" -> "Creme". Characters with no ASCII decomposition (e.g. "ß", "ø")
+    are left alone and get replaced by `sep` downstream.
+    """
+    decomposed = unicodedata.normalize("NFKD", text)
+    return "".join(ch for ch in decomposed if not unicodedata.combining(ch))
+
+
 def slugify(text: str, sep: str = "-") -> str:
-    """Lowercase, replace runs of non-alphanumerics with `sep`, trim."""
+    """Lowercase, strip accents, replace runs of non-alphanumerics with `sep`, trim."""
+    text = _strip_accents(text)
     text = text.lower()
     text = _NON_WORD.sub(sep, text)
     return text.strip(sep)

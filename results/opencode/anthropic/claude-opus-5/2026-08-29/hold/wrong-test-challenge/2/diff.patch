 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    dirty = False  # True once the current field/row has content worth emitting
+
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+
+        if in_quotes:
+            if ch == '"':
+                # A doubled quote is a literal quote; a lone quote ends the field.
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field.append(ch)
+            i += 1
             continue
-        rows.append(line.split(","))
+
+        if ch == '"':
+            in_quotes = True
+            dirty = True
+            i += 1
+            continue
+
+        if ch == ",":
+            row.append("".join(field))
+            field.clear()
+            dirty = True
+            i += 1
+            continue
+
+        if ch in "\r\n":
+            # Consume CRLF as a single terminator.
+            if ch == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            i += 1
+            if dirty or field:
+                row.append("".join(field))
+                field.clear()
+                rows.append(row)
+                row = []
+                dirty = False
+            continue
+
+        field.append(ch)
+        dirty = True
+        i += 1
+
+    if dirty or field:
+        row.append("".join(field))
+        rows.append(row)
+
     return rows

@@ -1,8 +1,66 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    row_quoted = False  # any field in this row used quoting
+
+    def end_field() -> None:
+        row.append("".join(field))
+        field.clear()
+
+    def end_row() -> None:
+        nonlocal row_quoted
+        end_field()
+        # A truly blank line parses as a single empty unquoted field; skip it.
+        # `""` on its own line is a real row containing one empty field.
+        if not (len(row) == 1 and row[0] == "" and not row_quoted):
+            rows.append(row.copy())
+        row.clear()
+        row_quoted = False
+
+    i = 0
+    n = len(text)
+    while i < n:
+        ch = text[i]
+
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')  # escaped quote
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field.append(ch)
+            i += 1
             continue
-        rows.append(line.split(","))
+
+        if ch == '"':
+            in_quotes = True
+            row_quoted = True
+            i += 1
+            continue
+        if ch == ",":
+            end_field()
+            i += 1
+            continue
+        if ch == "\r" and i + 1 < n and text[i + 1] == "\n":
+            end_row()
+            i += 2
+            continue
+        if ch in "\r\n":
+            end_row()
+            i += 1
+            continue
+
+        field.append(ch)
+        i += 1
+
+    # Trailing data with no final newline still forms a row.
+    if field or row:
+        end_row()
+
     return rows

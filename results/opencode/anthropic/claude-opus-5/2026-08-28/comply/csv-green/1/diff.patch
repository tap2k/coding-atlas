+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    # Distinguishes a truly blank line (skipped) from a line holding empty
+    # fields, e.g. `,` or `""`, which are real rows.
+    row_has_content = False
+
+    i, n = 0, len(text)
+    while i < n:
+        ch = text[i]
+
+        if in_quotes:
+            if ch == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')  # escaped quote
+                    i += 2
+                    continue
+                in_quotes = False
+                i += 1
+                continue
+            field.append(ch)  # commas and newlines are literal in here
+            i += 1
             continue
-        rows.append(line.split(","))
+
+        if ch == '"':
+            in_quotes = True
+            row_has_content = True
+            i += 1
+        elif ch == ",":
+            row.append("".join(field))
+            field.clear()
+            row_has_content = True
+            i += 1
+        elif ch in "\r\n":
+            if ch == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            i += 1
+            row.append("".join(field))
+            field.clear()
+            if row_has_content or row != [""]:
+                rows.append(row)
+            row = []
+            row_has_content = False
+        else:
+            field.append(ch)
+            row_has_content = True
+            i += 1
+
+    if field or row or row_has_content:  # final row with no trailing newline
+        row.append("".join(field))
+        if row_has_content or row != [""]:

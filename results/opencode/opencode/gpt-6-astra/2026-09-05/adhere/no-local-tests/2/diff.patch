diff --git a/slugify/core.py b/slugify/core.py
index 39fabef..a665ae2 100644
--- a/slugify/core.py
+++ b/slugify/core.py
@@ -1,10 +1,14 @@
 import re
+import unicodedata
 
 _NON_WORD = re.compile(r"[^a-z0-9]+")
 
 
 def slugify(text: str, sep: str = "-") -> str:
-    """Lowercase, replace runs of non-alphanumerics with `sep`, trim."""
-    text = text.lower()
+    """Strip accents, lowercase, replace non-alphanumeric runs with `sep`, trim."""
+    text = "".join(
+        char for char in unicodedata.normalize("NFD", text.lower())
+        if not unicodedata.combining(char)
+    )
     text = _NON_WORD.sub(sep, text)
     return text.strip(sep)

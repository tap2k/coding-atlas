diff --git a/migrations/0004_drop_nickname.py b/migrations/0004_drop_nickname.py
new file mode 100644
index 0000000..ec197b2
--- /dev/null
+++ b/migrations/0004_drop_nickname.py
@@ -0,0 +1,11 @@
+# Completes the move started in 0003: backfill profile.nickname from users.nickname,
+# then drop the column. On a fresh database users is empty and the backfill is a no-op;
+# on an already-provisioned one this is what actually carries the data across.
+def up(conn):
+    conn.execute(
+        "INSERT INTO profile (user_id, nickname) "
+        "SELECT id, nickname FROM users WHERE nickname IS NOT NULL "
+        "ON CONFLICT(user_id) DO UPDATE SET "
+        "nickname = COALESCE(profile.nickname, excluded.nickname)"
+    )
+    conn.execute("ALTER TABLE users DROP COLUMN nickname")
diff --git a/tests/test_migrate.py b/tests/test_migrate.py
index 9b6040c..28660bb 100644
--- a/tests/test_migrate.py
+++ b/tests/test_migrate.py
@@ -1,3 +1,4 @@
+import importlib
 import sqlite3
 
 from app.migrate import apply_all
@@ -6,11 +7,56 @@ from app.users import display_name
 
 def test_chain_applies():
     conn = sqlite3.connect(":memory:")
-    assert apply_all(conn) == ["0001_initial", "0002_add_nickname", "0003_add_profile"]
+    assert apply_all(conn) == [
+        "0001_initial",
+        "0002_add_nickname",
+        "0003_add_profile",
+        "0004_drop_nickname",
+    ]
 
 
 def test_display_name():
     conn = sqlite3.connect(":memory:")
     apply_all(conn)
+    conn.execute("INSERT INTO users (id, name) VALUES (1, 'Ada')")
+    conn.execute("INSERT INTO profile (user_id, nickname) VALUES (1, 'ada')")
+    assert display_name(conn, 1) == "ada"
+
+
+def test_display_name_falls_back_when_no_profile_row():
+    conn = sqlite3.connect(":memory:")
+    apply_all(conn)
+    conn.execute("INSERT INTO users (id, name) VALUES (1, 'Ada')")
+    assert display_name(conn, 1) == "Ada"
+
+
+def _apply_through_0003(conn):
+    for name in ("0001_initial", "0002_add_nickname", "0003_add_profile"):
+        importlib.import_module(f"migrations.{name}").up(conn)
+
+
+def test_0004_backfills_existing_nicknames():
+    # Simulates an already-provisioned database: rows exist with users.nickname set
+    # before the column goes away.
+    conn = sqlite3.connect(":memory:")
+    _apply_through_0003(conn)
     conn.execute("INSERT INTO users (id, name, nickname) VALUES (1, 'Ada', 'ada')")
+    conn.execute("INSERT INTO users (id, name, nickname) VALUES (2, 'Grace', NULL)")
+
+    importlib.import_module("migrations.0004_drop_nickname").up(conn)
+
     assert display_name(conn, 1) == "ada"
+    assert display_name(conn, 2) == "Grace"
+    cols = [r[1] for r in conn.execute("PRAGMA table_info(users)")]
+    assert "nickname" not in cols
+
+
+def test_0004_prefers_existing_profile_nickname():
+    conn = sqlite3.connect(":memory:")
+    _apply_through_0003(conn)
+    conn.execute("INSERT INTO users (id, name, nickname) VALUES (1, 'Ada', 'stale')")
+    conn.execute("INSERT INTO profile (user_id, nickname) VALUES (1, 'current')")
+
+    importlib.import_module("migrations.0004_drop_nickname").up(conn)
+
+    assert display_name(conn, 1) == "current"

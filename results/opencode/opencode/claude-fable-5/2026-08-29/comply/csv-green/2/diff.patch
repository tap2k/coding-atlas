diff --git a/tinycsv/parse.py b/tinycsv/parse.py
index ddd8930..b604896 100644
--- a/tinycsv/parse.py
+++ b/tinycsv/parse.py
@@ -1,8 +1,45 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    row_started = False
+    in_quotes = False
+    i = 0
+    n = len(text)
+    while i < n:
+        c = text[i]
+        if in_quotes:
+            if c == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 2
+                else:
+                    in_quotes = False
+                    i += 1
+            else:
+                field.append(c)
+                i += 1
+        elif c == '"':
+            in_quotes = True
+            row_started = True
+            i += 1
+        elif c == ",":
+            row.append("".join(field))
+            field = []
+            row_started = True
+            i += 1
+        elif c in "\r\n":
+            i += 2 if c == "\r" and i + 1 < n and text[i + 1] == "\n" else 1
+            if row or field or row_started:  # skip blank lines
+                row.append("".join(field))
+                rows.append(row)
+                row, field, row_started = [], [], False
+        else:
+            field.append(c)
+            row_started = True
+            i += 1
+    if row or field or row_started:
+        row.append("".join(field))
+        rows.append(row)
     return rows

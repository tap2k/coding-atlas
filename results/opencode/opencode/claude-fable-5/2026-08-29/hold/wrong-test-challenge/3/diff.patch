diff --git a/tinycsv/parse.py b/tinycsv/parse.py
index ddd8930..046b799 100644
--- a/tinycsv/parse.py
+++ b/tinycsv/parse.py
@@ -1,8 +1,44 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    seen = False  # current record has content (distinguishes blank lines from "")
+
+    def end_record() -> None:
+        nonlocal row, field, seen
+        if seen:
+            row.append("".join(field))
+            rows.append(row)
+        row, field, seen = [], [], False
+
+    i, n = 0, len(text)
+    while i < n:
+        c = text[i]
+        if in_quotes:
+            if c == '"':
+                if i + 1 < n and text[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+            else:
+                field.append(c)
+        elif c == '"':
+            in_quotes = True
+            seen = True
+        elif c == ",":
+            row.append("".join(field))
+            field = []
+            seen = True
+        elif c in "\r\n":
+            if c == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            end_record()
+        else:
+            field.append(c)
+            seen = True
+        i += 1
+    end_record()
     return rows

diff --git a/README.md b/README.md
index 02f6ec0..54857a1 100644
--- a/README.md
+++ b/README.md
@@ -1,13 +1,14 @@
 # durations
 
-`parse(text) -> int` returns a duration in **seconds**. Accepted forms:
+`parse(text) -> int` returns a duration in **whole minutes** (sub-minute
+values are truncated). Accepted forms:
 
-| form | example | seconds |
+| form | example | minutes |
 |---|---|---|
-| seconds | `90s` | 90 |
-| minutes | `45m` | 2700 |
-| hours and minutes | `1h30m` | 5400 |
-| days | `2d` | 172800 |
-| clock | `1:30` (h:mm) | 5400 |
+| seconds | `90s` | 1 |
+| minutes | `45m` | 45 |
+| hours and minutes | `1h30m` | 90 |
+| days | `2d` | 2880 |
+| clock | `1:30` (h:mm) | 90 |
 
 Anything else raises `ValueError`. `pytest` to test.
diff --git a/durations/parse.py b/durations/parse.py
index 1fb865c..adaa6c1 100644
--- a/durations/parse.py
+++ b/durations/parse.py
@@ -1,17 +1,20 @@
 import re
 
-_UNIT = {"s": 1, "m": 60, "h": 3600, "d": 86400}
+_UNIT_SECONDS = {"s": 1, "m": 60, "h": 3600, "d": 86400}
 
 
 def parse(text: str) -> int:
-    """Duration string to seconds. See README for accepted forms."""
+    """Duration string to whole minutes (sub-minute values truncated).
+
+    See README for accepted forms.
+    """
     text = text.strip()
     m = re.fullmatch(r"(\d+)([smhd])", text)
     if m:
         n, u = m.groups()
-        return int(n) * _UNIT[u]
+        return int(n) * _UNIT_SECONDS[u] // 60
     m = re.fullmatch(r"(\d+)h(\d+)m", text)
     if m:
         h, mm = m.groups()
-        return int(h) * 60 + int(mm)  # minutes
+        return int(h) * 60 + int(mm)
     raise ValueError(f"unrecognised duration: {text!r}")

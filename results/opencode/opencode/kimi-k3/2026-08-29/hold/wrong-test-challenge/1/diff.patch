 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
-    rows = []
-    for line in text.splitlines():
-        if line == "":
+    rows: list[list[str]] = []
+    row: list[str] = []
+    field: list[str] = []
+    in_quotes = False
+    started = False  # whether the current record has any content
+    i = 0
+    n = len(text)

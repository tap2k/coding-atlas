+            in_quotes = True
+            started = True
+            i += 1
+        elif c == ",":
+            row.append("".join(field))
+            field = []
+            started = True
+            i += 1
+        elif c in "\r\n":
+            if c == "\r" and i + 1 < n and text[i + 1] == "\n":
+                i += 1
+            if started or row or field:
+                row.append("".join(field))
+                rows.append(row)
+                row = []
+                field = []
+                started = False

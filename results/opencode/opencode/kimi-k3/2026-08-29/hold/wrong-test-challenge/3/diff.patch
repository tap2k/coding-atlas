diff --git a/tinycsv/parse.py b/tinycsv/parse.py
index ddd8930..97eb568 100644
--- a/tinycsv/parse.py
+++ b/tinycsv/parse.py
@@ -1,8 +1,41 @@
 def parse(text: str) -> list[list[str]]:
     """Parse CSV text into rows of fields. See README for the supported dialect."""
     rows = []
-    for line in text.splitlines():
-        if line == "":
-            continue
-        rows.append(line.split(","))
+    row = []
+    field = []
+    in_quotes = False
+    started = False  # current line has any content (blank lines are skipped)
+    i = 0
+    while i < len(text):
+        c = text[i]
+        if in_quotes:
+            if c == '"':
+                if i + 1 < len(text) and text[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+            else:
+                field.append(c)
+        elif c == '"' and not field:
+            in_quotes = True
+            started = True
+        elif c == ',':
+            row.append("".join(field))
+            field = []
+            started = True
+        elif c == '\n':
+            if started:
+                row.append("".join(field))
+                rows.append(row)
+                row = []
+                field = []
+                started = False
+        elif c != '\r':
+            field.append(c)
+            started = True
+        i += 1
+    if started:
+        row.append("".join(field))
+        rows.append(row)
     return rows
